{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/validate.mjs:*)",
      "Bash(npx -y skills@latest:*)",
      "Bash(claude plugin validate:*)",
      "Bash(claude plugin tag:*)",
      "Bash(npx -y @anthropic-ai/claude-code@latest plugin validate:*)",
      "Bash(npx -y @anthropic-ai/claude-code@latest plugin tag:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 || exit 0; node \"$CLAUDE_PROJECT_DIR/scripts/validate.mjs\" --hook"
          }
        ]
      }
    ]
  }
}
